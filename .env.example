# Application settings (safe defaults — no secrets here)
APP_NAME=CoreSat API
HOST=127.0.0.1
PORT=8000

# CORS origins (comma-separated, NO wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker threads (None = Python default, set positive int for bounded pool)
# WORKER_THREADS=8

# Database (compose defaults — local dev only)
DATABASE_URL=postgresql+asyncpg://coresat_app:coresat_app@localhost:5434/coresat
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/coresat

# LLM — local Ollama only (no cloud provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

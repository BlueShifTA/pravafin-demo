# Application settings (safe defaults — no secrets here)
APP_NAME=CoreSat API
HOST=127.0.0.1
PORT=8000

# CORS origins (comma-separated, NO wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker threads (None = Python default, set positive int for bounded pool)
# WORKER_THREADS=8

# === ADD YOUR SECRETS BELOW ===
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-here

# Application settings (safe defaults — no secrets here)
# NOTE: justfile uses `set dotenv-load`; its parser needs values with spaces
# quoted, so keep spaced values in double quotes.
APP_NAME="CoreSat API"
HOST=127.0.0.1
PORT=8000

# CORS origins (comma-separated, NO wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker threads (None = Python default, set positive int for bounded pool)
# WORKER_THREADS=8

# Database (compose defaults — local dev only)
DATABASE_URL=postgresql+asyncpg://coresat_app:coresat_app@localhost:5434/coresat
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/coresat

# LLM providers — each agent picks its backend independently.
# provider = ollama (local) | openai (cloud API)
COPILOT_PROVIDER=ollama
DRAFT_AGENT_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# RAG — document embeddings (Ollama, must be 768-d for the doc_chunks column)
# and the cross-encoder reranker (fastembed ONNX, downloaded on first use).
OLLAMA_EMBED_MODEL=nomic-embed-text
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# OpenAI — only needed when a *_PROVIDER above is set to openai.
# Put your real key here (this file is gitignored); leave blank otherwise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
